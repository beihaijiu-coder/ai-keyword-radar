# Product Hunt：去 Product Hunt 开发者后台申请免费 API token
PRODUCTHUNT_TOKEN=

# Google Trends 使用 pytrends，不需要密钥

# 邮件 Provider：MVP 不写死厂商，这里放你选择的邮件服务配置
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_API_URL=
EMAIL_FROM=
SITE_URL=https://your-domain.example

# 可选：Next.js API 写订阅文件的位置
SUBSCRIBERS_FILE=../data/subscribers.json
